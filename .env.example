# Optional build-time public website origin. Leave blank until the real HTTPS domain is ready.
# Set the root origin only, without /zh, query parameters or fragments; then rebuild.
NEXT_PUBLIC_SITE_URL=

# npm start uses process environment PORT (default 3000).
# For Windows reverse proxy hosting, npm run start:local binds 127.0.0.1:3100.
# Do not store Discord tokens, webhooks, payment secrets or account credentials here.
